@startuml use-case
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F4F5F1
  BorderColor #1E6B3C
}
skinparam actorBorderColor #12301F
title Sơ đồ use case – SportBooking

actor "Khách vãng lai" as Guest
actor "Khách hàng" as Customer
actor "Nhân viên" as Staff
actor "Quản trị viên" as Admin
actor "Socket client" as SocketClient

Guest <|-- Customer
Customer <|-- Staff
Staff <|-- Admin

rectangle "Hệ thống SportBooking" {
  usecase "Đăng ký tài khoản (F01)" as UC01
  usecase "Đăng nhập / đăng xuất (F02)" as UC02
  usecase "Cập nhật hồ sơ cá nhân (F03)" as UC03
  usecase "Tìm, lọc, sắp xếp sân (F04)" as UC04
  usecase "Xem chi tiết sân và lịch trống (F05)" as UC05
  usecase "Chọn giờ liên tiếp, xem tổng tiền (F06)" as UC06
  usecase "Đặt sân (F07)" as UC07
  usecase "Xem lịch sử đơn của mình (F08)" as UC08
  usecase "Hủy đơn (F09)" as UC09

  usecase "Xem, tìm, lọc tất cả đơn (F10)" as UC10
  usecase "Xác nhận / từ chối đơn (F11)" as UC11
  usecase "Đặt hộ khách tại quầy (F12)" as UC12
  usecase "Xác nhận nhận sân (F13)" as UC13
  usecase "Ghi nhận thanh toán (F14)" as UC14
  usecase "Xem nhật ký xử lý đơn (F15)" as UC15
  usecase "Xem tổng quan, doanh thu (F20)" as UC20

  usecase "Quản lý sân và giá (F16)" as UC16
  usecase "Quản lý loại sân (F17)" as UC17
  usecase "Quản lý tài khoản, phân quyền (F18)" as UC18
  usecase "Quản lý khung giờ (F19)" as UC19

  usecase "Tra cứu sân và giờ trống qua Socket (F21)" as UC21
}

Guest --> UC01
Guest --> UC04
Guest --> UC05

Customer --> UC02
Customer --> UC03
Customer --> UC07
Customer --> UC08
Customer --> UC09

Staff --> UC10
Staff --> UC11
Staff --> UC12
Staff --> UC13
Staff --> UC14
Staff --> UC15
Staff --> UC20

Admin --> UC16
Admin --> UC17
Admin --> UC18
Admin --> UC19

SocketClient --> UC21

UC07 ..> UC06 : <<include>>
UC12 ..> UC07 : <<include>>
UC09 ..> UC08 : <<extend>>
UC14 ..> UC13 : <<extend>>

note bottom of Admin
  Quản trị viên làm được mọi việc của nhân viên;
  nhân viên làm được mọi việc của khách hàng.
end note
@enduml
